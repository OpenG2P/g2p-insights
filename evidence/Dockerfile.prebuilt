# =============================================================================
# Maps — serve an ALREADY-BUILT Evidence site.
# =============================================================================
# The companion to Dockerfile, not a replacement for it.
#
#   Dockerfile           builds the site inside the image. Data-free by default,
#                        which is what CI publishes: a released artifact must not
#                        carry any deployment's registry data.
#   Dockerfile.prebuilt  packages a site you already built, WITH its data baked
#                        in, for standing a demo up against a specific
#                        environment.
#
# Evidence extracts all of its SQL at build time into parquet, so the database
# has to be reachable from wherever the build runs. In a cluster that means
# either a DB-connected image build or a slow, memory-hungry build inside the
# pod. Building on a machine that already has a port-forward and shipping the
# result avoids both.
#
#   cd evidence
#   rm -rf build .evidence/template            # `npm run build` does not clean
#   python3 sync_pack.py --pack <pack>         # boundaries must match the pack
#   npm run sources && npm run build           #   the environment's MDS holds
#   docker build -f Dockerfile.prebuilt -t <image>:<env> .
#
# The resulting image contains that environment's figures. Tag it per environment
# and do not treat it as a release artifact.
# =============================================================================
FROM nginx:1.27-alpine

# Port 3000 rather than nginx's default 80, to match the chart's
# insightMaps.service.targetPort and the Service that already existed in the nsr
# namespace.
COPY <<'CONF' /etc/nginx/conf.d/default.conf
server {
    listen 3000;
    server_name _;
    root /usr/share/nginx/html;

    # No `types` block here on purpose. Declaring one inside `server` REPLACES
    # nginx's whole MIME map rather than extending it, so adding a line for
    # .parquet silently demoted text/html to application/octet-stream and the
    # browser downloaded the page instead of rendering it. The bundled
    # mime.types already covers html/css/js/json and .wasm, which is the one
    # that actually matters (DuckDB-WASM will not instantiate an
    # octet-stream module). .parquet and .geojson are fetched by JS that parses
    # them regardless of the declared type.

    gzip on;
    gzip_types text/css application/javascript application/json application/geo+json;
    # Not parquet or wasm: both are already compressed, so gzipping them costs
    # CPU and saves nothing.

    location / {
        # SPA fallback — Evidence routes client-side, so a deep link like
        # /region/ET04 must return index.html rather than 404.
        try_files $uri $uri/ /index.html;
    }
}
CONF

COPY build/ /usr/share/nginx/html/

EXPOSE 3000
