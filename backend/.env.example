# =============================================================================
# Backend dev-run environment template
# =============================================================================
# Copy to backend/.env (already covered by .gitignore — do NOT commit your real
# values). Anything you leave commented out will use the script's default.
#
# All env vars below are read by backend/scripts/dev_run.sh, which auto-sources
# this file when it's present.
# =============================================================================

# ---- LLM (OpenRouter) --------------------------------------------------------
# Insight uses OpenRouter — one OpenAI-compatible gateway to any model.
# The base URL defaults to OpenRouter and normally needs no override.

# OpenRouter API key (sk-or-...). Leave blank + set INSIGHT_LLM__ENABLED=false
# to run with no AI at all.
INSIGHT_LLM__API_KEY=

# Any model id OpenRouter exposes:
#   anthropic/claude-sonnet-4.5   openai/gpt-4o   qwen/qwen3-32b
#   meta-llama/llama-3.3-70b-instruct
INSIGHT_LLM__MODEL=anthropic/claude-sonnet-4.5

# Set to false to disable AI features entirely (no key needed, Ask tab hidden).
# INSIGHT_LLM__ENABLED=false

# Qwen3 hybrid thinking. true → `/think` (deeper), false → `/no_think` (faster).
# Ignored by non-Qwen models.
INSIGHT_LLM__ENABLE_THINKING=false

# Optional attribution headers shown on your OpenRouter dashboard. Single quotes
# are required so the shell keeps the inner double quotes when sourced.
INSIGHT_LLM__EXTRA_HEADERS='{"HTTP-Referer":"http://localhost:5173","X-Title":"OpenG2P Insight (dev)"}'

# ---- DB / catalog (usually leave at defaults; the script knows the test-stack)
# DB_HOST=localhost
# DB_PORT=5433
# DB_NAME=registry
# DB_USER=postgres
# DB_PASSWORD=postgres
# INSIGHT_CATALOG_PATH=/abs/path/to/test-stack/postgres/catalog

# ---- External services -------------------------------------------------------
# INSIGHT_SUPERSET__URL=http://localhost:8088
# INSIGHT_SUPERSET__USERNAME=admin
# INSIGHT_SUPERSET__PASSWORD=admin
# INSIGHT_MASTERDATA__URL=https://master-data.trial.openg2p.org

# ---- Uvicorn -----------------------------------------------------------------
# UVICORN_HOST=0.0.0.0
# UVICORN_PORT=8000
# UVICORN_LOG_LEVEL=info
