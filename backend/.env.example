# =============================================================================
# Backend dev-run environment template
# =============================================================================
# Copy to backend/.env (already covered by .gitignore — do NOT commit your real
# values). Anything you leave commented out will use the script's default.
#
# All env vars below are read by backend/scripts/dev_run.sh, which auto-sources
# this file when it's present.
# =============================================================================

# ---- LLM provider ------------------------------------------------------------
# Pick one of:
#   anthropic           — native Claude (set ANTHROPIC_API_KEY below)
#   openai_compatible   — OpenRouter / Groq / vLLM / Together / etc.
INSIGHT_LLM__PROVIDER=openai_compatible

# For openai_compatible: the chat-completions base URL.
INSIGHT_LLM__BASE_URL=https://openrouter.ai/api/v1

# Provider API key. For anthropic this is your ANTHROPIC_API_KEY; for
# openai_compatible it's the provider's key (e.g. an OpenRouter `sk-or-...`).
INSIGHT_LLM__API_KEY=

# Model id as the provider lists it.
#   OpenRouter examples:  qwen/qwen3-32b   qwen/qwen3-30b-a3b   meta-llama/llama-3.3-70b-instruct
#   Anthropic examples:   claude-opus-4-7  claude-sonnet-4-6
INSIGHT_LLM__MODEL=qwen/qwen3-32b

# Qwen3 hybrid thinking mode. true  → prepend `/think`  (more tokens, deeper
# clarification routing).  false → prepend `/no_think` (faster, cheaper).
# Ignored by non-Qwen models.
INSIGHT_LLM__ENABLE_THINKING=false

# Optional headers — OpenRouter shows these on your dashboard for attribution.
# NOTE the single quotes around the JSON — required so the shell doesn't strip
# the inner double quotes when this file is sourced.
INSIGHT_LLM__EXTRA_HEADERS='{"HTTP-Referer":"http://localhost:5173","X-Title":"OpenG2P Insight (dev)"}'

# Anthropic key — only used when INSIGHT_LLM__PROVIDER=anthropic.
# ANTHROPIC_API_KEY=sk-ant-...

# ---- DB / catalog (usually leave at defaults; the script knows the test-stack)
# DB_HOST=localhost
# DB_PORT=5433
# DB_NAME=registry
# DB_USER=postgres
# DB_PASSWORD=postgres
# INSIGHT_CATALOG_PATH=/abs/path/to/test-stack/postgres/catalog

# ---- External services -------------------------------------------------------
# INSIGHT_SUPERSET__URL=http://localhost:8088
# INSIGHT_SUPERSET__USERNAME=admin
# INSIGHT_SUPERSET__PASSWORD=admin
# INSIGHT_MASTERDATA__URL=https://master-data.trial.openg2p.org

# ---- Uvicorn -----------------------------------------------------------------
# UVICORN_HOST=0.0.0.0
# UVICORN_PORT=8000
# UVICORN_LOG_LEVEL=info
