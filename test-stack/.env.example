# Copy to .env and fill in. Do NOT commit .env.
# `docker compose --env-file .env up` reads from this file.

# LLM
ANTHROPIC_API_KEY=
INSIGHT__LLM__MODEL=claude-opus-4-7

# Master Data Service — for tests we point at the trial instance by default.
# Override to a local MDS if you have one. The URL is also used by
# scripts/seed_master_data.py.
MASTERDATA_URL=https://master-data.trial.openg2p.org

# Superset admin (local container only — do not reuse production passwords)
SUPERSET_SECRET_KEY=please-change-me-in-real-deploys
SUPERSET_ADMIN_USERNAME=admin
SUPERSET_ADMIN_PASSWORD=admin
