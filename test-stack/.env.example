# Copy to .env and fill in. Do NOT commit .env.
# `docker compose --env-file .env up` reads from this file.

# LLM — Insight uses OpenRouter (one gateway, any model).
# Leave the key blank and set INSIGHT_LLM__ENABLED=false to run without AI.
OPENROUTER_API_KEY=
INSIGHT_LLM__MODEL=anthropic/claude-sonnet-4.5
# INSIGHT_LLM__ENABLED=false

# Master Data Service.
# Default is the LOCAL mock (service `mock-mds`), so the stack is fully
# self-contained with no external dependency. Point at a real MDS only if you
# specifically want to test against one, e.g.
#   MASTERDATA_URL=https://master-data.trial.openg2p.org
# NOTE: scripts/seed_master_data.py runs on the HOST, so it needs the published
# port form: http://localhost:8090
MASTERDATA_URL=http://mock-mds:8080

# Superset admin (local container only — do not reuse production passwords)
SUPERSET_SECRET_KEY=please-change-me-in-real-deploys
SUPERSET_ADMIN_USERNAME=admin
SUPERSET_ADMIN_PASSWORD=admin
